NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://user:password@127.0.0.1:3306/pawangtools
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000
APP_URL=http://localhost:5173
EMAIL_VERIFICATION_REQUIRED=false
REGISTRATION_SINGLE_ACCOUNT_PER_IP=false
FREE_PLAN_SINGLE_CLAIM_PER_IP=false
CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=

SESSION_SECRET=
TOKEN_SECRET=
HWID_HMAC_SECRET=
LICENSE_ENCRYPTION_KEY=

# Generic SMTP configuration. Brevo example: smtp-relay.brevo.com:587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
MAIL_FROM="PawangTools <no-reply@example.com>"

# Backward-compatible aliases also accepted:
# SMTP_PASSWORD=
# SMTP_FROM=

PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=

# Telegram alert for each newly created order. Keep these server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_DIR=./storage

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

CAPTCHA_SECRET_KEY=<SECRET_KEY_DARI_CLOUDFLARE>
VITE_TURNSTILE_SITE_KEY=<SITE_KEY_DARI_CLOUDFLARE>